{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/carta-las-palmas",
      "destination": "/carta-las-palmas/index.html"
    },
    {
      "source": "/carta-galdar",
      "destination": "/carta-galdar/index.html"
    },
    {
      "source": "/carta-telde",
      "destination": "/carta-telde/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
